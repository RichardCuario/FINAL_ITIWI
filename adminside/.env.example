# Public browser configuration (values are intentionally safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only configuration for adminside/api Vercel functions.
# Add these in the hosting provider's environment-variable settings, not to Git.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep this on one line; use literal \n between lines when copying the key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"
SUPABASE_URL=https://your-project.supabase.co
# Use an anon key unless an API endpoint specifically requires service-role access.
SUPABASE_KEY=your-supabase-key

# Didit server-only configuration. Add these in Vercel Project Settings → Environment Variables.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# Optional public HTTPS return URL after completion.
DIDIT_CALLBACK_URL=
# Required for Didit webhook writes and Super Admin role removal;
# never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
